rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function hasSuperAdminEmail() {
      return signedIn() && request.auth.token.email == 'idhamdjuanda@gmail.com';
    }
    function isSuperAdmin() {
      return hasSuperAdminEmail() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }
    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }
    function schoolMemberPath(schoolId, uid) {
      return /databases/$(database)/documents/schools/$(schoolId)/members/$(uid);
    }
    function isSchoolMember(schoolId) {
      return isSuperAdmin() || (signedIn() &&
        exists(userPath(request.auth.uid)) &&
        get(userPath(request.auth.uid)).data.accountType == 'school' &&
        get(userPath(request.auth.uid)).data.schoolId == schoolId &&
        exists(schoolMemberPath(schoolId, request.auth.uid)) &&
        get(schoolMemberPath(schoolId, request.auth.uid)).data.active == true);
    }
    function schoolRole(schoolId) {
      return get(schoolMemberPath(schoolId, request.auth.uid)).data.role;
    }
    function isSchoolAdmin(schoolId) {
      return isSuperAdmin() || (isSchoolMember(schoolId) && schoolRole(schoolId) in ['principal', 'administration']);
    }
    function isSchoolPrincipal(schoolId) {
      return isSchoolMember(schoolId) && schoolRole(schoolId) == 'principal';
    }
    function isSchoolOnboardingAdminAfter(schoolId) {
      return signedIn() &&
        schoolId == 'school_' + request.auth.uid &&
        getAfter(userPath(request.auth.uid)).data.accountType == 'school' &&
        getAfter(userPath(request.auth.uid)).data.schoolId == schoolId &&
        getAfter(userPath(request.auth.uid)).data.schoolRole in ['principal', 'administration'] &&
        getAfter(schoolMemberPath(schoolId, request.auth.uid)).data.uid == request.auth.uid &&
        getAfter(schoolMemberPath(schoolId, request.auth.uid)).data.role == getAfter(userPath(request.auth.uid)).data.schoolRole &&
        getAfter(schoolMemberPath(schoolId, request.auth.uid)).data.active == true;
    }
    function hasAssignedClassId(schoolId, classId) {
      return isSchoolMember(schoolId) &&
        schoolRole(schoolId) == 'teacher' &&
        classId is string &&
        classId in get(schoolMemberPath(schoolId, request.auth.uid)).data.assignedClassIds;
    }
    function hasAssignedClassName(schoolId, className) {
      return isSchoolMember(schoolId) &&
        schoolRole(schoolId) == 'teacher' &&
        className is string &&
        className in get(schoolMemberPath(schoolId, request.auth.uid)).data.assignedClassNames;
    }
    function canManageSchoolClassName(schoolId, className) {
      return isSchoolAdmin(schoolId) || hasAssignedClassName(schoolId, className);
    }
    function isHomeroomTeacherForClass(schoolId, classId) {
      return isSchoolMember(schoolId) &&
        schoolRole(schoolId) == 'teacher' &&
        classId is string &&
        exists(/databases/$(database)/documents/schools/$(schoolId)/classes/$(classId)) &&
        get(/databases/$(database)/documents/schools/$(schoolId)/classes/$(classId)).data.homeroomTeacherUid == request.auth.uid;
    }
    function validTeacherInvite(schoolId, inviteId) {
      return inviteId is string &&
      exists(/databases/$(database)/documents/schools/$(schoolId)/teacherInvites/$(inviteId)) &&
      get(/databases/$(database)/documents/schools/$(schoolId)/teacherInvites/$(inviteId)).data.schoolId == schoolId &&
      get(/databases/$(database)/documents/schools/$(schoolId)/teacherInvites/$(inviteId)).data.status == 'open';
    }
    function canCreateSchoolQuiz(schoolId, className) {
      return isSchoolPrincipal(schoolId) || hasAssignedClassName(schoolId, className);
    }
    function schoolOnboardingUpdate(uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isOwner(uid) &&
        resource.data.accountType == 'school' &&
        !resource.data.keys().hasAny(['schoolId', 'schoolRole']) &&
        request.resource.data.accountType == 'school' &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.schoolId == 'school_' + uid &&
        request.resource.data.schoolRole in ['principal', 'administration'] &&
        request.resource.data.schoolOnboardingStatus == 'complete' &&
        changed.hasOnly(['schoolId', 'schoolRole', 'schoolOnboardingStatus', 'updatedAt']) &&
        getAfter(/databases/$(database)/documents/schools/$(request.resource.data.schoolId)).data.ownerUid == uid &&
        getAfter(schoolMemberPath(request.resource.data.schoolId, uid)).data.uid == uid &&
        getAfter(schoolMemberPath(request.resource.data.schoolId, uid)).data.role == request.resource.data.schoolRole;
    }
    function schoolAdminUserUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.accountType == 'school' &&
        resource.data.schoolRole == 'teacher' &&
        request.resource.data.accountType == resource.data.accountType &&
        request.resource.data.schoolId == resource.data.schoolId &&
        request.resource.data.schoolRole == resource.data.schoolRole &&
        request.resource.data.role == resource.data.role &&
        isSchoolAdmin(resource.data.schoolId) &&
          changed.hasOnly(['name', 'phone', 'subjectIds', 'primarySubjectIds', 'additionalSubjectIds', 'assignedClassIds', 'assignedClassNames', 'nip', 'gender', 'address', 'education', 'employmentStatus', 'pendingApproval', 'status', 'disabled', 'updatedAt']);
    }
    function tokenMatchesUserAccountType(tokenId, uid) {
      let tokenData = getAfter(/databases/$(database)/documents/activationTokens/$(tokenId)).data;
      let userData = getAfter(/databases/$(database)/documents/users/$(uid)).data;
      return (
        tokenData.keys().hasAny(['accountType']) &&
        tokenData.accountType == 'school' &&
        userData.accountType == 'school'
      ) || (
        (!tokenData.keys().hasAny(['accountType']) || tokenData.accountType == 'individual') &&
        (!userData.keys().hasAny(['accountType']) || userData.accountType == 'individual')
      );
    }
    function ownerUserUpdate(uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isOwner(uid) &&
        request.resource.data.role == resource.data.role &&
        changed.hasOnly([
          'name', 'schoolName', 'phone', 'email', 'teacherRole',
          'profilePhotoKey', 'schoolLogoKey', 'updatedAt',
          'online', 'lastSeenAtMs', 'lastLoginAtMs', 'lastLoginAt',
          'status', 'disabled', 'activeTokenId', 'tokenActivatedAtMs',
          'activeUntilMs'
        ]) &&
        (
          !changed.hasAny(['status', 'disabled', 'activeTokenId', 'tokenActivatedAtMs', 'activeUntilMs']) ||
          (
            request.resource.data.status == 'active' &&
            request.resource.data.disabled == false &&
            request.resource.data.activeTokenId is string &&
            getAfter(/databases/$(database)/documents/activationTokens/$(request.resource.data.activeTokenId)).data.status == 'used' &&
            getAfter(/databases/$(database)/documents/activationTokens/$(request.resource.data.activeTokenId)).data.usedBy == uid &&
            tokenMatchesUserAccountType(request.resource.data.activeTokenId, uid) &&
            request.resource.data.activeUntilMs == getAfter(/databases/$(database)/documents/activationTokens/$(request.resource.data.activeTokenId)).data.accountExpiresAtMs &&
            request.resource.data.tokenActivatedAtMs == getAfter(/databases/$(database)/documents/activationTokens/$(request.resource.data.activeTokenId)).data.usedAtMs
          )
        );
    }

    match /users/{uid} {
      allow create: if isOwner(uid) && (
        (hasSuperAdminEmail() && request.resource.data.role == 'superadmin') ||
        (!hasSuperAdminEmail() && request.resource.data.role == 'teacher')
      ) || (
        request.resource.data.accountType == 'school' &&
        request.resource.data.schoolRole == 'teacher' &&
        request.resource.data.role == 'teacher' &&
        request.resource.data.status == 'active' &&
        isSchoolAdmin(request.resource.data.schoolId)
      ) || (
        isOwner(uid) &&
        request.resource.data.accountType == 'school' &&
        request.resource.data.schoolRole == 'teacher' &&
        request.resource.data.role == 'teacher' &&
        request.resource.data.status == 'pending' &&
        request.resource.data.disabled == false &&
        request.resource.data.inviteId is string &&
        validTeacherInvite(request.resource.data.schoolId, request.resource.data.inviteId) &&
        request.resource.data.email == request.auth.token.email
      );
      allow read: if isOwner(uid) || isSuperAdmin() ||
        (resource.data.accountType == 'school' && isSchoolAdmin(resource.data.schoolId));
      allow update: if isSuperAdmin() ||
        (isOwner(uid) && hasSuperAdminEmail() && request.resource.data.role == 'superadmin') ||
        ownerUserUpdate(uid) || schoolOnboardingUpdate(uid) || schoolAdminUserUpdate();
      allow delete: if isSuperAdmin();

      match /{subcollection}/{document=**} {
        allow read: if isOwner(uid) || isSuperAdmin();
        allow write: if isOwner(uid);
      }
    }

    match /schools/{schoolId} {
      allow create: if signedIn() &&
        schoolId == 'school_' + request.auth.uid &&
        request.resource.data.ownerUid == request.auth.uid &&
        getAfter(userPath(request.auth.uid)).data.accountType == 'school' &&
        getAfter(userPath(request.auth.uid)).data.schoolId == schoolId &&
        getAfter(userPath(request.auth.uid)).data.schoolRole in ['principal', 'administration'];
      allow read: if isSchoolMember(schoolId) || isSuperAdmin();
      allow update: if isSchoolAdmin(schoolId) || isSuperAdmin();
      allow delete: if isSchoolPrincipal(schoolId) || isSuperAdmin();

      match /members/{memberUid} {
        allow read: if isSchoolMember(schoolId) || isSuperAdmin();
        allow create: if (
          memberUid == request.auth.uid &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.role in ['principal', 'administration'] &&
          getAfter(userPath(request.auth.uid)).data.schoolId == schoolId &&
          getAfter(userPath(request.auth.uid)).data.schoolRole == request.resource.data.role
        ) || (
          isSchoolAdmin(schoolId) &&
          request.resource.data.uid == memberUid &&
          request.resource.data.role == 'teacher' &&
          getAfter(userPath(memberUid)).data.schoolId == schoolId &&
          getAfter(userPath(memberUid)).data.schoolRole == 'teacher'
        ) || (
          memberUid == request.auth.uid &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.role == 'teacher' &&
          request.resource.data.active == false &&
          request.resource.data.pendingApproval == true &&
          request.resource.data.inviteId is string &&
          validTeacherInvite(schoolId, request.resource.data.inviteId) &&
          getAfter(userPath(memberUid)).data.schoolId == schoolId &&
          getAfter(userPath(memberUid)).data.schoolRole == 'teacher'
        );
        allow update: if isSchoolAdmin(schoolId) || (
          memberUid == request.auth.uid &&
          isSchoolMember(schoolId) &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'updatedAt'])
        );
        allow delete: if isSchoolAdmin(schoolId);
      }

      match /teacherInvites/{inviteId} {
        allow get: if true;
        allow list: if false;
        allow create: if isSchoolAdmin(schoolId) && request.resource.data.schoolId == schoolId && request.resource.data.status == 'open';
        allow update, delete: if isSchoolAdmin(schoolId);
      }

      match /students/{studentId} {
        allow read: if isSchoolAdmin(schoolId) ||
          (isSchoolMember(schoolId) && (hasAssignedClassId(schoolId, resource.data.classId) || isHomeroomTeacherForClass(schoolId, resource.data.classId)));
        allow create: if isSchoolAdmin(schoolId) || isHomeroomTeacherForClass(schoolId, request.resource.data.classId);
        allow update: if isSchoolAdmin(schoolId) ||
          (isHomeroomTeacherForClass(schoolId, resource.data.classId) && request.resource.data.classId == resource.data.classId);
        allow delete: if isSchoolAdmin(schoolId);
      }

      match /savingsTransactions/{transactionId} {
        allow read: if isSchoolAdmin(schoolId) || isHomeroomTeacherForClass(schoolId, resource.data.classId);
        allow create: if isSchoolAdmin(schoolId) || isHomeroomTeacherForClass(schoolId, request.resource.data.classId);
        allow update: if isSchoolAdmin(schoolId) || isHomeroomTeacherForClass(schoolId, resource.data.classId);
        allow delete: if false;
      }

      match /classes/{classId} {
        allow read: if isSchoolMember(schoolId) || isSuperAdmin();
        allow create, update, delete: if isSchoolAdmin(schoolId);
      }

      match /subjects/{subjectId} {
        allow read: if isSchoolMember(schoolId) || isSuperAdmin();
        allow create, update, delete: if isSchoolAdmin(schoolId);
      }

      match /curriculumProfiles/{profileId} {
        allow read: if isSchoolMember(schoolId) || isSuperAdmin();
        allow create, update, delete: if isSchoolAdmin(schoolId);
      }

      match /programs/{programId} {
        allow read: if isSchoolMember(schoolId) || isSuperAdmin();
        allow create, update, delete: if isSchoolAdmin(schoolId);
      }

      match /subjectChoices/{choiceId} {
        allow read: if isSchoolAdmin(schoolId) ||
          (isSchoolMember(schoolId) && (isHomeroomTeacherForClass(schoolId, resource.data.classId) || resource.data.studentUid == request.auth.uid));
        allow create: if isSchoolAdmin(schoolId) ||
          (isSchoolMember(schoolId) && isHomeroomTeacherForClass(schoolId, request.resource.data.classId));
        allow update: if isSchoolAdmin(schoolId) ||
          (isSchoolMember(schoolId) && isHomeroomTeacherForClass(schoolId, resource.data.classId));
        allow delete: if isSchoolAdmin(schoolId);
      }

      match /schedules/{scheduleId} {
        allow read: if isSchoolMember(schoolId) || isSuperAdmin();
        allow create, update, delete: if isSchoolAdmin(schoolId);
      }

      match /teachingAssignments/{assignmentId} {
        allow read: if isSchoolAdmin(schoolId) ||
          (isSchoolMember(schoolId) && resource.data.teacherUid == request.auth.uid);
        allow create, update: if isSchoolAdmin(schoolId) &&
          request.resource.data.schoolId == schoolId &&
          request.resource.data.weeklyPeriods is number &&
          request.resource.data.weeklyPeriods >= 1 &&
          request.resource.data.weeklyPeriods <= 20;
        allow delete: if isSchoolAdmin(schoolId);
      }

      match /settings/{settingId} {
        allow read: if isSchoolMember(schoolId) || isSuperAdmin();
        allow create: if isSchoolAdmin(schoolId) ||
          (settingId == 'academic' && isSchoolOnboardingAdminAfter(schoolId));
        allow update, delete: if isSchoolAdmin(schoolId);
      }

      match /academicYears/{academicYearId} {
        allow read: if isSchoolMember(schoolId) || isSuperAdmin();
        allow create: if isSchoolAdmin(schoolId) || isSchoolOnboardingAdminAfter(schoolId);
        allow update, delete: if isSchoolAdmin(schoolId);
      }

      match /attendanceSessions/{sessionId} {
        allow read: if isSchoolAdmin(schoolId) ||
          (isSchoolMember(schoolId) && hasAssignedClassName(schoolId, resource.data.className));
        allow create: if canManageSchoolClassName(schoolId, request.resource.data.className);
        allow update: if canManageSchoolClassName(schoolId, resource.data.className) &&
          request.resource.data.className == resource.data.className;
        allow delete: if canManageSchoolClassName(schoolId, resource.data.className);
      }

      match /exams/{examId} {
        allow read: if isSchoolAdmin(schoolId) ||
          (isSchoolMember(schoolId) && hasAssignedClassName(schoolId, resource.data.className));
        allow create: if canManageSchoolClassName(schoolId, request.resource.data.className);
        allow update: if canManageSchoolClassName(schoolId, resource.data.className) &&
          request.resource.data.className == resource.data.className;
        allow delete: if canManageSchoolClassName(schoolId, resource.data.className);
      }

      match /manualGrades/{gradeId} {
        allow read: if isSchoolAdmin(schoolId) ||
          (isSchoolMember(schoolId) && hasAssignedClassName(schoolId, resource.data.className));
        allow create: if canManageSchoolClassName(schoolId, request.resource.data.className);
        allow update: if canManageSchoolClassName(schoolId, resource.data.className) &&
          request.resource.data.className == resource.data.className;
        allow delete: if canManageSchoolClassName(schoolId, resource.data.className);
      }

      // Subject Election — Pemilihan Mapel Pilihan (Kurikulum Merdeka SMA/SMK/MA)
      match /subjectElections/{studentId} {
        // School members can read all elections in their school
        allow read: if isSchoolMember(schoolId);
        // Public can create/update their own election record (student self-registration)
        // Protected: status, reviewedBy fields can only be set by school members
        allow create: if
          request.resource.data.studentId == studentId &&
          request.resource.data.schoolId == schoolId &&
          request.resource.data.selectedSubjectIds is list &&
          request.resource.data.selectedSubjectIds.size() >= 1 &&
          request.resource.data.selectedSubjectIds.size() <= 8 &&
          request.resource.data.nis is string &&
          request.resource.data.studentName is string &&
          request.resource.data.className is string &&
          request.resource.data.status == 'pending' &&
          request.resource.data.submittedAtMs is number &&
          !request.resource.data.keys().hasAny(['reviewedByUid', 'reviewedByName', 'reviewedAtMs']);
        allow update: if isSchoolMember(schoolId) || (
          // Student can update own pending election (revise choices) while period is open
          !request.resource.data.keys().hasAny(['reviewedByUid', 'reviewedByName', 'reviewedAtMs']) &&
          request.resource.data.studentId == resource.data.studentId &&
          request.resource.data.schoolId == resource.data.schoolId &&
          request.resource.data.status == 'pending' &&
          resource.data.status == 'pending'
        );
        allow delete: if isSchoolAdmin(schoolId);
      }

      // Subject Election Config
      match /subjectElectionConfig/{configId} {
        allow read: if isSchoolMember(schoolId) || true; // public read for student registration page
        allow create, update, delete: if isSchoolAdmin(schoolId);
      }
    }

    match /activationTokens/{tokenId} {
      allow get: if signedIn();
      allow list, delete: if isSuperAdmin();
      allow create: if isSuperAdmin() &&
        request.resource.data.code == tokenId &&
        request.resource.data.accountType in ['individual', 'school'];
      allow update: if isSuperAdmin() ||
        (
          signedIn() &&
          resource.data.status == 'active' &&
          resource.data.tokenExpiresAt > request.time &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'usedBy', 'usedByEmail', 'usedAtMs', 'usedAt',
            'accountExpiresAtMs'
          ]) &&
          request.resource.data.status == 'used' &&
          request.resource.data.usedBy == request.auth.uid &&
          request.resource.data.usedByEmail == request.auth.token.email &&
          request.resource.data.usedAtMs is number &&
          request.resource.data.accountExpiresAtMs is number &&
          tokenMatchesUserAccountType(tokenId, request.auth.uid) &&
          getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.activeTokenId == tokenId &&
          getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.activeUntilMs == request.resource.data.accountExpiresAtMs
        );
    }

    match /studentDirectory/{directoryId} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if signedIn() && (resource.data.ownerUid == request.auth.uid || isSuperAdmin());
    }

    match /crossClassAttendance/{recordId} {
      // The scanner checks whether the deterministic record already exists
      // before creating it. A missing document has no resource.data, so allow
      // that existence check while keeping existing records owner-protected.
      allow get: if signedIn() &&
        (!exists(/databases/$(database)/documents/crossClassAttendance/$(recordId)) ||
         resource.data.ownerUid == request.auth.uid ||
         resource.data.scannerUid == request.auth.uid ||
         isSuperAdmin());
      allow list: if false;
      // Absensi hanya boleh tersimpan di sesi milik guru yang memiliki siswa.
      // Jalur lintas guru dinonaktifkan; pemindahan siswa harus disetujui lebih dulu.
      allow create: if false;
      allow update: if false;
      allow delete: if signedIn() && (resource.data.scannerUid == request.auth.uid || isSuperAdmin());
    }

    match /studentClassLinks/{linkId} {
      allow read: if signedIn() &&
        (resource.data.sourceOwnerUid == request.auth.uid ||
         resource.data.targetOwnerUid == request.auth.uid ||
         isSuperAdmin());
      allow create: if signedIn() &&
        request.resource.data.targetOwnerUid == request.auth.uid &&
        request.resource.data.sourceOwnerUid is string &&
        request.resource.data.sourceStudentId is string &&
        request.resource.data.targetStudentId is string;
      allow update, delete: if signedIn() &&
        (resource.data.sourceOwnerUid == request.auth.uid ||
         resource.data.targetOwnerUid == request.auth.uid ||
         isSuperAdmin());
    }
    match /articles/{articleId} {
      allow read: if resource.data.published == true || isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    match /savingsTransactions/{transactionId} {
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || isSuperAdmin());
      allow create: if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.studentId is string &&
        request.resource.data.studentName is string &&
        request.resource.data.nis is string &&
        request.resource.data.type in ['deposit', 'withdrawal'] &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0 &&
        request.resource.data.transactionDate is string &&
        request.resource.data.officerName is string &&
        request.resource.data.status == 'active' &&
        request.resource.data.createdAtMs is number;
      allow update: if signedIn() &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.amount == resource.data.amount &&
        request.resource.data.type == resource.data.type &&
        request.resource.data.status == 'void' &&
        resource.data.status == 'active' &&
        request.resource.data.voidReason is string &&
        request.resource.data.voidReason.size() >= 3;
      allow delete: if false;
    }
    match /publicSnapshots/{snapshotId} {
      allow read: if resource.data.published == true;
      allow create: if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.type in ['guardian', 'quiz', 'task', 'absence'] &&
        (!request.resource.data.keys().hasAny(['schoolId']) ||
         (request.resource.data.type == 'quiz' &&
          canCreateSchoolQuiz(request.resource.data.schoolId, request.resource.data.className)) ||
         (request.resource.data.type == 'absence' && isSchoolAdmin(request.resource.data.schoolId)));
      allow update: if signedIn() &&
        (resource.data.ownerUid == request.auth.uid ||
         (resource.data.keys().hasAny(['schoolId']) && isSchoolPrincipal(resource.data.schoolId))) &&
        request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if signedIn() &&
        (resource.data.ownerUid == request.auth.uid ||
         (resource.data.keys().hasAny(['schoolId']) && isSchoolPrincipal(resource.data.schoolId)));
    }

    match /publicLinkCodes/{linkCode} {
      allow get: if resource.data.published == true || signedIn();
      allow list: if false;
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['code', 'type', 'snapshotId', 'ownerUid', 'schoolId', 'published', 'updatedAt']) &&
        request.resource.data.code == linkCode &&
        request.resource.data.type == 'quiz' &&
        request.resource.data.snapshotId is string &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.published == true &&
        getAfter(/databases/$(database)/documents/publicSnapshots/$(request.resource.data.snapshotId)).data.type == 'quiz' &&
        getAfter(/databases/$(database)/documents/publicSnapshots/$(request.resource.data.snapshotId)).data.published == true &&
        getAfter(/databases/$(database)/documents/publicSnapshots/$(request.resource.data.snapshotId)).data.ownerUid == request.auth.uid &&
        getAfter(/databases/$(database)/documents/publicSnapshots/$(request.resource.data.snapshotId)).data.accessCode == linkCode;
      allow update: if signedIn() &&
        (resource.data.ownerUid == request.auth.uid ||
         (resource.data.keys().hasAny(['schoolId']) && isSchoolPrincipal(resource.data.schoolId))) &&
        request.resource.data.code == resource.data.code &&
        request.resource.data.type == resource.data.type &&
        request.resource.data.snapshotId == resource.data.snapshotId &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        (!resource.data.keys().hasAny(['schoolId']) || request.resource.data.schoolId == resource.data.schoolId);
      allow delete: if signedIn() &&
        (resource.data.ownerUid == request.auth.uid ||
         (resource.data.keys().hasAny(['schoolId']) && isSchoolPrincipal(resource.data.schoolId)));
    }

    match /publicResponses/{responseId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'snapshotId', 'ownerUid', 'studentId', 'attendanceNumber', 'nis',
          'studentName', 'className', 'guardian', 'phone', 'photoKey',
          'photoThumbnailKey', 'photoAspect', 'status', 'createdAt'
        ]) &&
        request.resource.data.snapshotId is string &&
        request.resource.data.studentId is string &&
        request.resource.data.guardian is string &&
        request.resource.data.guardian.size() >= 3 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() >= 10 &&
        request.resource.data.phone.size() <= 15 &&
        (!request.resource.data.keys().hasAny(['photoKey', 'photoThumbnailKey', 'photoAspect']) ||
          (request.resource.data.photoKey is string &&
           request.resource.data.photoKey.matches('^guardian-submissions/' + request.resource.data.ownerUid + '/' + request.resource.data.studentId + '/photo-[A-Za-z0-9-]+\\.(jpg|png|webp)$') &&
           request.resource.data.photoThumbnailKey is string &&
           request.resource.data.photoThumbnailKey.matches('^guardian-submissions/' + request.resource.data.ownerUid + '/' + request.resource.data.studentId + '/thumbnail-[A-Za-z0-9-]+\\.(jpg|png|webp)$') &&
           request.resource.data.photoAspect in ['3:4', '4:3'])) &&
        request.resource.data.status == 'pending' &&
        get(/databases/$(database)/documents/publicSnapshots/$(request.resource.data.snapshotId)).data.published == true &&
        get(/databases/$(database)/documents/publicSnapshots/$(request.resource.data.snapshotId)).data.type == 'guardian' &&
        request.resource.data.ownerUid == get(/databases/$(database)/documents/publicSnapshots/$(request.resource.data.snapshotId)).data.ownerUid;
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn() &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.snapshotId == resource.data.snapshotId &&
        request.resource.data.studentId == resource.data.studentId;
    }

    match /publicQuizDeviceLocks/{attemptId} {
      allow get, list: if signedIn() &&
        (resource.data.ownerUid == request.auth.uid ||
         (resource.data.keys().hasAny(['schoolId']) && isSchoolPrincipal(resource.data.schoolId)));
      allow create: if
        request.resource.data.keys().hasOnly([
          'attemptId', 'snapshotId', 'examId', 'ownerUid', 'schoolId', 'studentId', 'nis',
          'sessionId', 'clientSessionId', 'deviceLabel', 'claimedAtMs',
          'heartbeatAtMs', 'expiresAtMs', 'updatedAt'
        ]) &&
        request.resource.data.attemptId == attemptId &&
        request.resource.data.snapshotId is string &&
        request.resource.data.examId is string &&
        request.resource.data.ownerUid is string &&
        request.resource.data.studentId is string &&
        request.resource.data.nis is string &&
        request.resource.data.sessionId is string &&
        request.resource.data.sessionId.size() >= 16 &&
        request.resource.data.clientSessionId is string &&
        request.resource.data.clientSessionId.size() >= 16 &&
        request.resource.data.deviceLabel is string &&
        request.resource.data.claimedAtMs is number &&
        request.resource.data.heartbeatAtMs is number &&
        request.resource.data.expiresAtMs is number &&
        get(/databases/$(database)/documents/publicSnapshots/$(request.resource.data.snapshotId)).data.published == true &&
        get(/databases/$(database)/documents/publicSnapshots/$(request.resource.data.snapshotId)).data.type == 'quiz' &&
        get(/databases/$(database)/documents/publicSnapshots/$(request.resource.data.snapshotId)).data.startAt <= request.time &&
        get(/databases/$(database)/documents/publicSnapshots/$(request.resource.data.snapshotId)).data.endAt > request.time &&
        request.resource.data.ownerUid == get(/databases/$(database)/documents/publicSnapshots/$(request.resource.data.snapshotId)).data.ownerUid &&
        (!request.resource.data.keys().hasAny(['schoolId']) ||
         request.resource.data.schoolId == get(/databases/$(database)/documents/publicSnapshots/$(request.resource.data.snapshotId)).data.schoolId) &&
        request.resource.data.examId == get(/databases/$(database)/documents/publicSnapshots/$(request.resource.data.snapshotId)).data.examId &&
        request.resource.data.expiresAtMs == get(/databases/$(database)/documents/publicSnapshots/$(request.resource.data.snapshotId)).data.endAtMs;
      allow update: if
        request.resource.data.attemptId == resource.data.attemptId &&
        request.resource.data.snapshotId == resource.data.snapshotId &&
        request.resource.data.examId == resource.data.examId &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.keys().hasAny(['schoolId']) == resource.data.keys().hasAny(['schoolId']) &&
        (!resource.data.keys().hasAny(['schoolId']) || request.resource.data.schoolId == resource.data.schoolId) &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.nis == resource.data.nis &&
        request.resource.data.sessionId == resource.data.sessionId &&
        request.resource.data.clientSessionId == resource.data.clientSessionId &&
        request.resource.data.deviceLabel == resource.data.deviceLabel &&
        request.resource.data.expiresAtMs == resource.data.expiresAtMs &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedAtMs', 'heartbeatAtMs', 'updatedAt']);
      allow delete: if signedIn() &&
        (resource.data.ownerUid == request.auth.uid ||
         (resource.data.keys().hasAny(['schoolId']) && isSchoolPrincipal(resource.data.schoolId)));
    }

    match /publicQuizAttempts/{attemptId} {
      allow get: if
        (signedIn() && (resource.data.ownerUid == request.auth.uid ||
          (resource.data.keys().hasAny(['schoolId']) && isSchoolPrincipal(resource.data.schoolId)))) ||
        (resource.data.snapshotId is string &&
          get(/databases/$(database)/documents/publicSnapshots/$(resource.data.snapshotId)).data.published == true);
      allow list: if
        (signedIn() && (resource.data.ownerUid == request.auth.uid ||
          (resource.data.keys().hasAny(['schoolId']) && isSchoolPrincipal(resource.data.schoolId)))) ||
        (
          resource.data.snapshotId is string &&
          get(/databases/$(database)/documents/publicSnapshots/$(resource.data.snapshotId)).data.type == 'quiz' &&
          get(/databases/$(database)/documents/publicSnapshots/$(resource.data.snapshotId)).data.endAt <= request.time
        );
      allow create: if
        request.resource.data.keys().hasOnly([
          'snapshotId', 'examId', 'ownerUid', 'schoolId', 'studentId', 'nis', 'studentName',
          'className', 'status', 'answers', 'violations', 'startedAtMs',
          'deadlineMs', 'reloginCount', 'loginEvents', 'randomSeed', 'startedAt', 'updatedAt'
        ]) &&
        request.resource.data.snapshotId is string &&
        request.resource.data.studentId is string &&
        request.resource.data.nis is string &&
        request.resource.data.status == 'active' &&
        request.resource.data.answers is map &&
        request.resource.data.violations is list &&
        request.resource.data.reloginCount == 0 &&
        request.resource.data.loginEvents is list &&
        get(/databases/$(database)/documents/publicSnapshots/$(request.resource.data.snapshotId)).data.published == true &&
        get(/databases/$(database)/documents/publicSnapshots/$(request.resource.data.snapshotId)).data.type == 'quiz' &&
        get(/databases/$(database)/documents/publicSnapshots/$(request.resource.data.snapshotId)).data.startAt <= request.time &&
        get(/databases/$(database)/documents/publicSnapshots/$(request.resource.data.snapshotId)).data.endAt > request.time &&
        request.resource.data.ownerUid == get(/databases/$(database)/documents/publicSnapshots/$(request.resource.data.snapshotId)).data.ownerUid &&
        (!request.resource.data.keys().hasAny(['schoolId']) ||
         request.resource.data.schoolId == get(/databases/$(database)/documents/publicSnapshots/$(request.resource.data.snapshotId)).data.schoolId) &&
        request.resource.data.examId == get(/databases/$(database)/documents/publicSnapshots/$(request.resource.data.snapshotId)).data.examId;
      allow update: if
        request.resource.data.snapshotId == resource.data.snapshotId &&
        request.resource.data.examId == resource.data.examId &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.keys().hasAny(['schoolId']) == resource.data.keys().hasAny(['schoolId']) &&
        (!resource.data.keys().hasAny(['schoolId']) || request.resource.data.schoolId == resource.data.schoolId) &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.nis == resource.data.nis &&
        request.resource.data.studentName == resource.data.studentName &&
        request.resource.data.className == resource.data.className &&
        request.resource.data.status in ['active', 'finished'] &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['score', 'correctCount']) ||
          (signedIn() && (resource.data.ownerUid == request.auth.uid || (resource.data.keys().hasAny(['schoolId']) && isSchoolPrincipal(resource.data.schoolId)))) ||
          get(/databases/$(database)/documents/publicSnapshots/$(resource.data.snapshotId)).data.endAt <= request.time ||
          get(/databases/$(database)/documents/publicSnapshots/$(resource.data.snapshotId)).data.endedManually == true
        ) &&
        (!request.resource.data.keys().hasAny(['score']) ||
          (request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score <= 100)) &&
        get(/databases/$(database)/documents/publicSnapshots/$(resource.data.snapshotId)).data.published == true;
      allow delete: if signedIn() &&
        (resource.data.ownerUid == request.auth.uid ||
         (resource.data.keys().hasAny(['schoolId']) && isSchoolPrincipal(resource.data.schoolId)));
    }

    match /publicAbsenceResponses/{responseId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'snapshotId', 'ownerUid', 'schoolId', 'sessionId', 'studentId', 'nis',
          'studentName', 'className', 'attendanceStatus', 'reason', 'status',
          'createdAt'
        ]) &&
        request.resource.data.snapshotId is string &&
        request.resource.data.sessionId is string &&
        request.resource.data.studentId is string &&
        request.resource.data.attendanceStatus in ['sick', 'permission'] &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() >= 3 &&
        request.resource.data.reason.size() <= 300 &&
        request.resource.data.status == 'pending' &&
        get(/databases/$(database)/documents/publicSnapshots/$(request.resource.data.snapshotId)).data.published == true &&
        get(/databases/$(database)/documents/publicSnapshots/$(request.resource.data.snapshotId)).data.type == 'absence' &&
        request.resource.data.ownerUid == get(/databases/$(database)/documents/publicSnapshots/$(request.resource.data.snapshotId)).data.ownerUid &&
        (!request.resource.data.keys().hasAny(['schoolId']) || request.resource.data.schoolId == get(/databases/$(database)/documents/publicSnapshots/$(request.resource.data.snapshotId)).data.schoolId) &&
        request.resource.data.sessionId == get(/databases/$(database)/documents/publicSnapshots/$(request.resource.data.snapshotId)).data.sessionId &&
        request.resource.data.studentId == get(/databases/$(database)/documents/publicSnapshots/$(request.resource.data.snapshotId)).data.student.id;
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || (resource.data.keys().hasAny(['schoolId']) && isSchoolAdmin(resource.data.schoolId)));
      allow update: if signedIn() &&
        (resource.data.ownerUid == request.auth.uid || (resource.data.keys().hasAny(['schoolId']) && isSchoolAdmin(resource.data.schoolId))) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.snapshotId == resource.data.snapshotId &&
        request.resource.data.sessionId == resource.data.sessionId &&
        request.resource.data.studentId == resource.data.studentId;
    }
  }
}
