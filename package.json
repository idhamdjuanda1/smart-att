{
  "name": "smart-att",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node build/run-pages-dev.cjs",
    "dev:hot": "vinext dev",
    "build": "node build/run-vinext-build.cjs",
    "verify:worker": "node --check worker/index.ts && node --check worker/student-card-pdf.js && node --check worker/admin-delete.js && node --check build/stage-cloudflare-pages.mjs",
    "build:pages": "npm run build && npm run verify:worker && node build/stage-cloudflare-pages.mjs",
    "start": "vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "deploy:cloudflare": "npm run build:pages && wrangler pages deploy .pages-deploy --project-name smart-att",
    "deploy:firestore": "firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "0.45.2",
    "firebase": "^12.16.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.24.0",
    "next": "16.2.6",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^5.20260719.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "^4.112.0"
  },
  "type": "module"
}
